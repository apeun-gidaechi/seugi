# API
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PORT=8080
DATA_FILE=./data/seugi.json
UPLOAD_DIR=./data/uploads
# Docker Compose PostgreSQL. Set a strong password and keep DATABASE_URL in sync for local API runs.
POSTGRES_DB=seugi
POSTGRES_USER=seugi
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://seugi:replace-with-a-strong-password@localhost:5432/seugi
# Omit S3_BUCKET to use UPLOAD_DIR. IAM/default AWS credentials are supported.
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_PUBLIC_BASE_URL=
# Optional S3-compatible endpoint (for MinIO, etc.)
S3_ENDPOINT=
NEIS_API_KEY=your-neis-open-api-key

# Catseugi AI (Responses API; set a model available to your OpenAI project)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Firebase Cloud Messaging (single-line JSON service account)
FIREBASE_SERVICE_ACCOUNT_JSON=

# OAuth authorization-code exchange
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WEB_REDIRECT_URI=
# Mobile Google SDK serverAuthCode exchange uses an empty redirect URI, matching the original clients.
APPLE_WEB_CLIENT_ID=com.seugi.services
APPLE_MOBILE_CLIENT_ID=
# JWT generated with your Apple team ID/key ID/private key
APPLE_CLIENT_SECRET=

# SMTP email verification (codes expire after 10 minutes)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Web Vite client
VITE_SERVER_URL=http://localhost:8080

# Expo mobile client (use your LAN IP on physical devices)
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
