# Use a reachable API URL (10.0.2.2 for the Android emulator, LAN IP for devices).
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# OAuth 2.0 Web client ID. Must match API GOOGLE_CLIENT_ID; public ID only, never a secret.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Native iOS OAuth client ID and its reversed-client-ID URL scheme for the Expo config plugin.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Apple Development Team used to sign native iOS builds and the WidgetKit extension.
EXPO_IOS_TEAM_ID=
