{
  "name": "@seugi/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client --scheme seugi",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "start:playground": "sh scripts/start-playground-metro.sh",
    "start:playground:tunnel": "EXPO_PUBLIC_APP_VARIANT=playground expo start --dev-client --scheme seugi-playground --tunnel",
    "ios:playground": "sh -c '. scripts/playground-device-env.sh && exec pnpm exec expo run:ios --no-bundler'",
    "ios:playground:device": "sh scripts/ios-playground-device.sh",
    "build": "tsc --noEmit && expo export --platform android --platform ios",
    "check": "tsc --noEmit",
    "test": "tsc --noEmit && node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@bittingz/expo-widgets": "2.9.0",
    "@react-native-google-signin/google-signin": "13.1.0",
    "@seugi/api-client": "workspace:*",
    "@seugi/contracts": "workspace:*",
    "@seugi/design-tokens": "workspace:*",
    "@seugi/media-picker": "workspace:*",
    "emoji-picker-react": "4.22.3",
    "expo": "^52.0.0",
    "expo-apple-authentication": "~7.1.3",
    "expo-application": "~6.0.2",
    "expo-clipboard": "~7.0.1",
    "expo-dev-client": "~5.0.20",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-haptics": "~14.0.1",
    "expo-notifications": "~0.29.14",
    "expo-secure-store": "~14.0.1",
    "expo-sharing": "~13.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-android-widget": "^0.15.1",
    "react-native-svg": "^15.15.5",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@react-native-community/cli": "15.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "typescript": "^5.7.3"
  }
}
