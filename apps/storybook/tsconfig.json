{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../web/src/*"],
      "@/pages/*": ["../web/src/Pages/*"],
      "@/components/*": ["../web/src/Components/*"],
      "@seugi/mobile/*": ["../mobile/src/*"]
    },
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": [".storybook", "stories", "env.d.ts", "../web/@types/**/*.d.ts"]
}
