{
  "name": "@seugi/storybook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm sync-stories && storybook dev -p 6006",
    "build": "pnpm sync-stories && storybook build --disable-telemetry",
    "check": "tsc --noEmit && node scripts/check-component-story-coverage.mjs && node scripts/check-page-story-coverage.mjs && pnpm build && node scripts/check-storybook-index.mjs && node scripts/run-storybook-test-runner.mjs",
    "test:smoke": "node scripts/run-storybook-test-runner.mjs",
    "sync-stories": "node scripts/sync-component-stories.mjs && node scripts/sync-page-stories.mjs"
  },
  "dependencies": {
    "@react-oauth/google": "^0.12.2",
    "@seugi/design-tokens": "workspace:*",
    "js-cookie": "^3.0.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.23.1",
    "styled-components": "^6.1.8",
    "swr": "^2.3.3"
  },
  "devDependencies": {
    "@storybook/test-runner": "^0.19.1",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "http-server": "^14.1.1",
    "playwright": "1.64.0",
    "storybook": "^8.6.14",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  }
}
