    "sync-stories": "node scripts/sync-component-stories.mjs"
  },
  "dependencies": {
    "@seugi/design-tokens": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.30.1",
    "styled-components": "^6.1.8"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "storybook": "^8.6.14",
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  }
}
